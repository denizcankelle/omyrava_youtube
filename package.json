{
  "name": "omyrava-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Omyrava Studio - yerel uyku muzigi ve video uretim paneli",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "worker": "tsx src/worker/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "spessasynth_core": "4.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
