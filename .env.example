# Kopyalayip .env olarak kaydedin. Gizli bilgi icermez.

# Veritabani ve calisma dosyalari (varsayilan: ./data)
DATA_DIR=./data

# Hazir videolarin konulacagi klasor (varsayilan: ./output)
OUTPUT_DIR=./output

# Bos birakilirsa sistem PATH'indeki ffmpeg kullanilir (winget ile kurulumda otomatik).
# Ornek (Windows): FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Worker ayarlari
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=1

# Enstrüman sesleri (SoundFont). Varsayılan: ./soundfonts/FluidR3_GM.sf2 (MIT lisansı)
SOUNDFONT_PATH=
